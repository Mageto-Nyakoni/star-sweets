---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import OrderInspirationPicker from '../components/OrderInspirationPicker.astro';
import CakeSizeGuide from '../components/CakeSizeGuide.astro';
import { cakeOrderOptions as fallbackOrderOptions } from '../data/orderFallback.js';
import { bakeryMenu } from '../data/bakeryMenu';

let orderOptions = fallbackOrderOptions;
let orderSource = 'sample';

const { isSanityConfigured, fetchCakeOrderOptions } = await import('../lib/sanity.js');

if (isSanityConfigured()) {
  try {
    orderOptions = await fetchCakeOrderOptions();
    orderSource = 'sanity';
  } catch {
    orderOptions = fallbackOrderOptions;
  }
}

const money = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});

const priceLabel = (amount = 0, base = false) => {
  const value = Number(amount) || 0;
  return base ? money.format(value) : value === 0 ? 'Included' : `+${money.format(value)}`;
};

const customizationPrice = 10;
const cakeGalleryItems = Array.isArray(orderOptions.gallery) ? orderOptions.gallery : [];
const cupcakeGalleryItems = Array.isArray(orderOptions.cupcakeGallery) ? orderOptions.cupcakeGallery : [];
---

<Layout
  title="Order Cakes & Baked Goods - Star Sweets"
  description="Order cakes, cupcakes, cookies, breads, and pastries from Star Sweets with a live estimate"
>
  <Navbar />

  <main class="order-page">
    <section class="order-intro" aria-labelledby="order-title">
      <div>
        <p class="order-kicker">Made to order</p>
        <h1 id="order-title">Order something sweet</h1>
        <p>
          Pick what you'd like. You'll see the estimate change as you go
        </p>
      </div>
    </section>

    <form id="cake-builder" class="order-builder is-starting" enctype="multipart/form-data" novalidate>
      <input
        class="order-honeypot"
        type="text"
        name="website"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <div class="order-form">
        <details class="order-section order-start" data-form-step>
          <summary class="section-copy">
            <p class="step-label">1</p>
            <h2 id="order-choice-heading">What do you want to order?</h2>
          </summary>
          <fieldset aria-labelledby="order-choice-heading">
            <p class="field-note">Pick one or more</p>
            <p class="order-service-note">Cakes are made in Boston, MA for pick-up only in Quincy Center or Fenway.</p>
            <div class="order-type-grid">
              <label class="choice-card order-type-card">
                <input type="checkbox" name="includeCake" value="yes" aria-controls="cake-options" />
                <span><strong>Cakes</strong></span>
              </label>
              <label class="choice-card order-type-card">
                <input type="checkbox" name="includeCupcakes" value="yes" aria-controls="cupcakes-options" />
                <span><strong>Cupcakes</strong></span>
              </label>
              <label class="choice-card order-type-card">
                <input type="checkbox" name="includeBakery" value="yes" aria-controls="bakery-options" />
                <span><strong>Other baked goods</strong></span>
              </label>
            </div>
          </fieldset>
          <button class="step-continue" type="button" data-step-continue>Continue</button>
        </details>

        <details class="order-section order-reveal hidden" id="cake-options" data-form-step data-cake-section>
          <summary class="section-copy">
            <p class="step-label">3</p>
            <h2 id="size-heading">Cake size</h2>
          </summary>

          <fieldset data-cake-sizes aria-labelledby="size-heading">
            <CakeSizeGuide sizes={orderOptions.sizes} />
          </fieldset>

          <div
            class="notice-box size-restriction-notice"
            data-size-restriction-notice
            role="status"
            hidden
          >
            <strong>This cake is offered as-is</strong>
            <p>Customization is unavailable for this size</p>
          </div>
          <button class="step-continue" type="button" data-step-continue>Continue</button>
        </details>

        <details class="order-section order-reveal hidden" data-form-step data-customization-section>
          <summary class="section-copy">
            <p class="step-label">4</p>
            <h2 id="customization-heading">Customize your cake</h2>
            <p class="field-note">Vanilla, chocolate, and red velvet are included. Each custom option adds $10</p>
          </summary>

          <fieldset>
            <legend>Cake flavor</legend>
            <div class="option-grid compact">
              <label class="choice-card">
                <input type="radio" name="cakeFlavor" value="vanilla" data-label="Vanilla" data-price="0" checked />
                <span><strong>Vanilla</strong><small>Classic vanilla cake</small></span>
                <em>Included</em>
              </label>
              <label class="choice-card">
                <input type="radio" name="cakeFlavor" value="chocolate" data-label="Chocolate" data-price="0" />
                <span><strong>Chocolate</strong><small>Classic chocolate cake</small></span>
                <em>Included</em>
              </label>
              <label class="choice-card">
                <input type="radio" name="cakeFlavor" value="red-velvet" data-label="Red Velvet" data-price="0" />
                <span><strong>Red Velvet</strong><small>Classic red velvet cake</small></span>
                <em>Included</em>
              </label>
              <label class="choice-card">
                <input
                  type="radio"
                  name="cakeFlavor"
                  value="custom"
                  data-label="Custom Cake Flavor"
                  data-price={customizationPrice}
                />
                <span><strong>Custom Cake Flavor</strong><small>Request a flavor outside the three basics</small></span>
                <em>{priceLabel(customizationPrice)}</em>
              </label>
            </div>
          </fieldset>

          <div class="customization-detail hidden" data-customization-detail="cakeFlavor">
            <label>
              <span>Custom cake flavor</span>
              <textarea
                name="customFlavorRequest"
                rows="4"
                placeholder="Describe the cake flavor you would like"
                disabled
              ></textarea>
            </label>
            <p class="field-note">A custom flavor adds $10. I'll let you know if I can make it</p>
          </div>

          <fieldset>
            <legend>Frosting flavor</legend>
            <div class="option-grid compact">
              <label class="choice-card">
                <input type="radio" name="frostingFlavor" value="vanilla-swiss-meringue" data-label="Vanilla Swiss Meringue Buttercream" checked />
                <span><strong>Vanilla Swiss Meringue Buttercream</strong></span>
                <em>Included</em>
              </label>
              <label class="choice-card">
                <input type="radio" name="frostingFlavor" value="chocolate-swiss-meringue" data-label="Chocolate Swiss Meringue Buttercream" />
                <span><strong>Chocolate Swiss Meringue Buttercream</strong></span>
                <em>Included</em>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend>Additional customizations</legend>
            <div class="option-grid compact">
              <label class="choice-card">
                <input type="checkbox" name="flowers" value="yes" data-label="Flowers" data-price={customizationPrice} />
                <span><strong>Flowers</strong><small>Add floral decorations to the cake</small></span>
                <em>{priceLabel(customizationPrice)}</em>
              </label>
              <label class="choice-card">
                <input type="checkbox" name="specializedDesign" value="yes" data-label="Specialized Designs" data-price={customizationPrice} />
                <span><strong>Specialized Designs</strong><small>Request a specific theme or decorative treatment</small></span>
                <em>{priceLabel(customizationPrice)}</em>
              </label>
              <label class="choice-card">
                <input type="checkbox" name="customFilling" value="yes" data-label="Custom Filling" data-price={customizationPrice} />
                <span><strong>Custom Filling</strong><small>Choose a filling between the cake layers</small></span>
                <em>{priceLabel(customizationPrice)}</em>
              </label>
              <label class="choice-card">
                <input type="checkbox" name="customButtercream" value="yes" data-label="Custom Buttercream" data-price={customizationPrice} />
                <span><strong>Custom Buttercream</strong><small>Request a custom buttercream</small></span>
                <em>{priceLabel(customizationPrice)}</em>
              </label>
            </div>
          </fieldset>

          {[
            ['flowers', 'Flower details', 'Describe the flowers, colors, or placement you would like'],
            ['specializedDesign', 'Specialized design details', 'Describe the theme or design you would like'],
            ['customFilling', 'Custom filling', 'Describe the filling you would like between the cake layers'],
            ['customButtercream', 'Custom buttercream', 'Describe the custom buttercream you would like'],
          ].map(([name, label, placeholder]) => (
            <div class="customization-detail hidden" data-customization-detail={name}>
              <label>
                <span>{label}</span>
                <textarea name={`${name}Request`} rows="3" placeholder={placeholder} disabled></textarea>
              </label>
            </div>
          ))}
          <button class="step-continue" type="button" data-step-continue>Continue</button>
        </details>

        <details class="order-section order-reveal hidden" data-form-step data-inspiration-section>
          <summary class="section-copy">
            <p class="step-label">5</p>
            <h2 id="inspiration-heading">Cake inspiration</h2>
            <p class="field-note" data-inspiration-section-note>Optional · Photos and notes</p>
          </summary>

          <div class="inspiration-section-content">
            <OrderInspirationPicker kind="cake" items={cakeGalleryItems} />
          </div>
          <button class="step-continue" type="button" data-step-continue>Continue</button>
        </details>
        {[
          { key: 'cupcakes', title: 'Create your cupcakes', categories: ['Cupcakes'], description: "Choose your flavor and number of dozens. If you have a look in mind, tell me" },
          { key: 'bakery', title: 'Cookies, breads, and pastries', categories: ['Cookies', 'Breads', 'Pastries'], description: "Add what you'd like. The quantities are for the portions shown" },
        ].map((group) => (
          <details class="order-section order-reveal hidden" data-form-step data-order-panel={group.key} id={`${group.key}-options`}>
            <summary class="section-copy">
              <p class="step-label"></p>
              <h2 id={`${group.key}-heading`}>{group.title}</h2>
              <p class="field-note">{group.description}</p>
            </summary>
            {group.categories.map((category) => (
            <fieldset>
              <legend>{category}</legend>
              <div class="bakery-grid">
                {bakeryMenu.filter((item) => item.category === category).map((item) => (
                  <div class="bakery-card">
                    <div>
                      <strong>{item.name}</strong>
                      <small>{item.portion}</small>
                      <em>{item.price === null ? 'Price TBD' : money.format(item.price)}</em>
                    </div>
                    <label>
                      <span>Quantity</span>
                      <input type="number" disabled name={`quantity-${item.id}`} min="0" max="99" step="1" value="0"
                        aria-label={`Quantity: ${item.name}, ${item.portion}`} data-bakery-quantity
                        data-product-id={item.id} data-label={`${item.name} (${item.portion})`}
                        data-price={item.price ?? ''} data-pricing-pending={item.price === null ? 'true' : 'false'} />
                    </label>
                  </div>
                ))}
              </div>
              {category === 'Cupcakes' && (
                <div class="cupcake-options hidden" data-cupcake-options>
                  <fieldset>
                    <legend>Cupcake flavor</legend>
                    <div class="flavor-tabs">
                      <label><input type="radio" name="cupcakeFlavor" value="vanilla" disabled /> Vanilla</label>
                      <label><input type="radio" name="cupcakeFlavor" value="chocolate" disabled /> Chocolate</label>
                    </div>
                  </fieldset>
                  <label>
                    <span>Visual suggestions (optional)</span>
                    <textarea name="cupcakeVisualSuggestions" rows="3" maxlength="2000" disabled
                      placeholder="Share colors, a theme, or a look you like"></textarea>
                  </label>
                  <p class="field-note">Cupcakes come in vanilla or chocolate. Share the colors or style you have in mind, and I'll confirm the design with you</p>
                </div>
              )}
              {category === 'Cookies' && <p class="field-note">Baker's Choice isn't in the total yet. I'll confirm the price with you</p>}
            </fieldset>
            ))}
            {group.key === 'cupcakes' && (
              <div class="cupcake-inspiration" data-cupcake-inspiration>
                <h3>Cupcake inspiration</h3>
                <p class="field-note">See a cupcake style you like? Pick up to three, or upload your own photos</p>
                <OrderInspirationPicker kind="cupcake" items={cupcakeGalleryItems} />
              </div>
            )}
            <button class="step-continue" type="button" data-step-continue>Continue</button>
          </details>
        ))}

        <details class="order-section order-reveal hidden" data-form-step data-contact-section>
          <summary class="section-copy">
            <p class="step-label">1</p>
            <h2 id="contact-heading">Contact, date, and pickup</h2>
            <p class="field-note">I'll need your name, event date, and a mobile number for texts. Please order at least one week ahead</p>
          </summary>

          <div class="field-grid">
            <label>
              <span>Name</span>
              <input type="text" name="customerName" autocomplete="name" required />
            </label>
            <label>
              <span>Event date</span>
              <input type="date" name="eventDate" required />
              <small class="field-note" data-min-event-date-note></small>
            </label>
            <label>
              <span>Email (optional)</span>
              <input type="email" name="email" autocomplete="email" />
            </label>
            <label>
              <span>Mobile number for texts</span>
              <input type="tel" name="phone" autocomplete="tel" inputmode="tel" required aria-describedby="text-number-note" />
              <small id="text-number-note" class="field-note">I'll text you here to confirm your order and payment details</small>
            </label>
          </div>

          <div class="pickup-section">
            <p class="field-note">The exact address and time of pick up will be coordinated with you after order confirmation</p>
            <fieldset>
              <legend>Preferred pickup location</legend>
              <div class="pickup-options">
                <label class="choice-card">
                  <input type="radio" name="pickupLocation" value="quincy" required />
                  <span><strong>Quincy Center</strong></span>
                </label>
                <label class="choice-card">
                  <input type="radio" name="pickupLocation" value="fenway" required />
                  <span><strong>Fenway</strong></span>
                </label>
              </div>
            </fieldset>
            <label class="pickup-confirmation">
              <input type="checkbox" name="bostonMetroConfirmed" value="yes" required />
              <span>I confirm I can pick up in the location selected</span>
            </label>
          </div>
          <button class="step-continue" type="button" data-step-continue>Review order</button>
        </details>

      </div>

      <aside class="order-summary order-reveal hidden" aria-labelledby="summary-heading">
        <details class="summary-inner" data-form-step data-review-step>
          <summary class="summary-toggle">
            <p class="summary-source">
              {orderSource === 'sanity' ? 'Live menu pricing' : 'Menu pricing · cake prices are samples'}
            </p>
            <h2 id="summary-heading">Estimate</h2>
            <output id="order-total" for="cake-builder">$0</output>
          </summary>
          <div class="summary-details">
          <p class="summary-note">
            *This is just an estimate and pricing is subject to change. The final price will be confirmed once the request has been submitted and reviewed.
          </p>

          <p class="summary-note" data-pending-price-note hidden>Baker's Choice isn't included in this subtotal. I'll confirm its price with you</p>

          <dl id="summary-lines" class="summary-lines"></dl>

          <section class="order-next-steps" aria-labelledby="order-next-steps-heading">
            <h3 id="order-next-steps-heading">What happens next</h3>
            <ol>
              <li>I'll review your date and order details.</li>
              <li>I'll text you within 24 hours to discuss the details, final price, and payment. Your order is confirmed once we agree by text.</li>
              <li>I'll send the exact pickup address and time for Quincy Center or Fenway.</li>
            </ol>
          </section>

          <div id="form-message" class="form-message" role="status" aria-live="polite"></div>

          <button class="submit-button" type="submit" data-submit-button>
            Send order request
          </button>
          </div>
        </details>

        <section class="pricing-explainer" aria-labelledby="pricing-explainer-heading">
          <p class="pricing-explainer-kicker">Behind the price</p>
          <h2 id="pricing-explainer-heading">Wondering what goes into the price?</h2>
          <p class="pricing-explainer-placeholder">
            I started making these cakes as a hobby, and I still do it because I love it.
            I'm also a full-time dental student. My prices reflect the ingredients and hours I put into each cake.
          </p>
          <div class="pricing-explainer-points">
            <p>
              <strong>Ingredients</strong>
              <span>
                Ingredients and supplies are part of each cake's cost. Special flavors and decorations can cost more.
              </span>
            </p>
            <p>
              <strong>Time and craft</strong>
              <span>
                Every cake takes at least six hours. I bake, assemble, and decorate each one by hand.
                Detailed designs take longer.
              </span>
            </p>
            <p>
              <strong>Custom design</strong>
              <span>
                Custom designs can call for special molds or extra ingredients. I use them when your design needs them.
              </span>
            </p>
          </div>
        </section>
      </aside>

      <div class="mobile-estimate-bar hidden" data-mobile-estimate aria-label="Current estimate">
        <div class="mobile-estimate-copy">
          <span data-mobile-estimate-label>Estimate</span>
          <output data-mobile-estimate-total for="cake-builder">$0.00</output>
        </div>
        <button type="button" data-mobile-estimate-review>Review order <span aria-hidden="true">&uarr;</span></button>
      </div>
    </form>

    <dialog class="order-confirmation" id="order-confirmation" aria-labelledby="order-confirmation-title" aria-describedby="order-confirmation-copy">
      <div class="order-confirmation-card">
        <div class="order-confetti" aria-hidden="true"></div>
        <button class="order-confirmation-close" type="button" data-confirmation-close aria-label="Close confirmation">&times;</button>
        <img class="order-confirmation-logo" src="/StarSweets-logo-trimmed.png" alt="Star Sweets" width="216" height="135" />
        <h2 id="order-confirmation-title">Your Request Is In!</h2>
        <p id="order-confirmation-copy">I've saved your request. I'll text you within 24 hours to confirm the order details, final price, and payment arrangements. I'll confirm your order and pickup after we agree by text.</p>
        <button class="order-confirmation-done" type="button" data-confirmation-close>Done</button>
      </div>
    </dialog>

    <script is:inline>
      const form = document.getElementById('cake-builder');
      const totalOutput = document.getElementById('order-total');
      const summaryLines = document.getElementById('summary-lines');
      const message = document.getElementById('form-message');
      const confirmation = document.getElementById('order-confirmation');
      const confetti = confirmation.querySelector('.order-confetti');
      const eventDateInput = form.elements.eventDate;
      const eventDateNote = form.querySelector('[data-min-event-date-note]');
      const sizeRestrictionNotice = form.querySelector('[data-size-restriction-notice]');
      const customizationSection = form.querySelector('[data-customization-section]');
      const inspirationSection = form.querySelector('[data-inspiration-section]');
      const formSteps = Array.from(form.querySelectorAll('[data-form-step]'));
      const stepBodies = new Map(formSteps.map((step) => {
        const body = document.createElement('div');
        body.className = 'step-body';
        const summary = step.querySelector(':scope > summary');
        while (summary.nextSibling) body.append(summary.nextSibling);
        step.append(body);
        return [step, body];
      }));
      const choiceStep = form.querySelector('.order-start');
      const reviewStep = form.querySelector('[data-review-step]');
      const mobileEstimate = form.querySelector('[data-mobile-estimate]');
      const mobileEstimateLabel = mobileEstimate.querySelector('[data-mobile-estimate-label]');
      const mobileEstimateTotal = mobileEstimate.querySelector('[data-mobile-estimate-total]');
      const formatter = new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });
      const minEventLeadDays = 7;
      const maxInspirationSelections = 3;
      const maxFiles = 5;
      const maxFileSize = 2 * 1024 * 1024;
      const maxTotalFileSize = 4 * 1024 * 1024;
      const allowedTypes = ['image/png', 'image/jpeg', 'image/webp'];
      const cakePicker = createInspirationPicker(form.querySelector('[data-inspiration-group="cake"]'));
      const cupcakePicker = createInspirationPicker(form.querySelector('[data-inspiration-group="cupcake"]'));
      const paidCustomizationNames = [
        'flowers',
        'specializedDesign',
        'customFilling',
        'customButtercream',
      ];

      function visibleSteps() {
        return formSteps.filter((step) => !step.closest('.hidden'));
      }

      let activeStepTransition = null;

      function finishStepTransition() {
        if (!activeStepTransition) return;
        const { animations, closing, bodies } = activeStepTransition;
        activeStepTransition = null;
        animations.forEach((animation) => animation.cancel());
        closing.forEach((panel) => { panel.open = false; });
        form.style.overflowAnchor = '';
        bodies.forEach((body) => {
          body.style.height = '';
          body.style.opacity = '';
          body.style.overflow = '';
        });
      }

      function openStep(step, scroll = false) {
        if (step?.closest('.hidden')) return;
        finishStepTransition();
        const closing = formSteps.filter((panel) => panel.open && panel !== step);
        const opening = step && !step.open ? step : null;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (reducedMotion) {
          closing.forEach((panel) => { panel.open = false; });
          if (opening) opening.open = true;
          if (scroll && step) step.scrollIntoView({ block: 'start' });
          return;
        }

        const animations = [];
        const bodies = [];
        let collapseAbove = 0;
        const timing = { duration: 320, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'forwards' };

        closing.forEach((panel) => {
          const body = stepBodies.get(panel);
          const height = body.getBoundingClientRect().height;
          if (step && (panel.compareDocumentPosition(step) & Node.DOCUMENT_POSITION_FOLLOWING)) {
            const summaryMargin = panel.matches('.order-section')
              ? Number.parseFloat(window.getComputedStyle(panel.querySelector(':scope > summary')).marginBottom) || 0
              : 0;
            collapseAbove += height + summaryMargin;
          }
          body.style.height = `${height}px`;
          body.style.overflow = 'hidden';
          bodies.push(body);
          animations.push(body.animate([
            { height: `${height}px`, opacity: 1 },
            { height: '0px', opacity: 0 },
          ], timing));
        });

        if (opening) {
          opening.open = true;
          const body = stepBodies.get(opening);
          const height = body.scrollHeight;
          body.style.height = '0px';
          body.style.overflow = 'hidden';
          bodies.push(body);
          animations.push(body.animate([
            { height: '0px', opacity: 0 },
            { height: `${height}px`, opacity: 1 },
          ], timing));
        }

        if (!animations.length) {
          if (scroll && step) step.scrollIntoView({ behavior: 'smooth', block: 'start' });
          return;
        }

        const transition = { animations, closing, bodies };
        activeStepTransition = transition;
        form.style.overflowAnchor = 'none';
        if (scroll && step) {
          const margin = Number.parseFloat(window.getComputedStyle(step).scrollMarginTop) || 0;
          const top = window.scrollY + step.getBoundingClientRect().top - collapseAbove - margin;
          window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
        }
        Promise.all(animations.map((animation) => animation.finished)).then(() => {
          if (activeStepTransition !== transition) return;
          finishStepTransition();
        }).catch(() => {});
      }

      formSteps.forEach((step) => {
        step.querySelector(':scope > summary')?.addEventListener('click', (event) => {
          event.preventDefault();
          if (step.open) openStep(null);
          else openStep(step);
        });
      });

      form.querySelectorAll('[data-step-continue]').forEach((button) => {
        button.addEventListener('click', () => {
          const current = button.closest('[data-form-step]');
          if (current === choiceStep && !checked('includeCake') && !checked('includeCupcakes') && !checked('includeBakery')) return;
          const steps = visibleSteps();
          openStep(steps[steps.indexOf(current) + 1], true);
        });
      });

      mobileEstimate.querySelector('[data-mobile-estimate-review]').addEventListener('click', () => {
        openStep(reviewStep, true);
      });

      if ('IntersectionObserver' in window) {
        const summaryObserver = new IntersectionObserver(([entry]) => {
          mobileEstimate.classList.toggle('is-at-summary', entry.isIntersecting);
        }, { threshold: 0.05 });
        summaryObserver.observe(form.querySelector('.summary-inner'));
      }

      function checked(name) {
        return form.querySelector(`[name="${name}"]:checked`);
      }

      function checkedAll(name) {
        return Array.from(form.querySelectorAll(`[name="${name}"]:checked`));
      }

      function priceOf(input) {
        return Number(input?.dataset.price || 0);
      }

      function labelOf(input) {
        return input?.dataset.label || '';
      }

      function formatDateOnly(date) {
        return date.toISOString().slice(0, 10);
      }

      function formatDisplayDate(date) {
        return new Intl.DateTimeFormat('en-US', {
          timeZone: 'UTC',
          month: 'long',
          day: 'numeric',
          year: 'numeric',
        }).format(date);
      }

      function minimumEventDate() {
        const parts = Object.fromEntries(new Intl.DateTimeFormat('en-US', {
          timeZone: 'America/New_York', year: 'numeric', month: '2-digit', day: '2-digit',
        }).formatToParts(new Date()).map(({ type, value }) => [type, value]));
        return new Date(Date.UTC(Number(parts.year), Number(parts.month) - 1, Number(parts.day) + minEventLeadDays));
      }

      function dateValueToLocalDate(value) {
        const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
        if (!match) return null;

        const year = Number(match[1]);
        const monthIndex = Number(match[2]) - 1;
        const day = Number(match[3]);
        const date = new Date(Date.UTC(year, monthIndex, day));

        if (
          date.getUTCFullYear() !== year
          || date.getUTCMonth() !== monthIndex
          || date.getUTCDate() !== day
        ) {
          return null;
        }

        return date;
      }

      function syncMinimumEventDate() {
        const minDate = minimumEventDate();
        eventDateInput.min = formatDateOnly(minDate);
        eventDateNote.textContent = `Earliest available event date: ${formatDisplayDate(minDate)}`;
      }

      function customizationsAreRestricted() {
        return !checked('includeCake') || checked('cakeSize')?.dataset.customizations === 'none';
      }

      function setCustomizationDetails() {
        const selectedFlavor = checked('cakeFlavor')?.value;
        const selections = {
          cakeFlavor: selectedFlavor === 'custom',
          ...Object.fromEntries(paidCustomizationNames.map((name) => [name, Boolean(checked(name))])),
        };

        form.querySelectorAll('[data-customization-detail]').forEach((panel) => {
          const selected = Boolean(selections[panel.dataset.customizationDetail]);
          panel.classList.toggle('hidden', !selected);
          const input = panel.querySelector('textarea');
          input.disabled = !selected;
          if (!selected) input.value = '';
        });
      }

      function setCustomizationAvailability() {
        const restricted = customizationsAreRestricted();
        const includeCake = Boolean(checked('includeCake'));
        form.querySelector('[data-cake-section]').classList.toggle('hidden', !includeCake);
        const sizes = form.querySelector('[data-cake-sizes]');
        sizes.classList.toggle('hidden', !includeCake);
        sizes.querySelectorAll('input').forEach((input) => { input.disabled = !includeCake; });
        form.querySelector('.pricing-explainer').classList.toggle('hidden', !includeCake);
        sizeRestrictionNotice.hidden = !includeCake || !restricted;
        [customizationSection, inspirationSection].forEach((section) => {
          section.classList.toggle('hidden', restricted);
          section.querySelectorAll('input, textarea').forEach((control) => {
            control.disabled = restricted;
            if (!restricted) return;

            if (control instanceof HTMLInputElement && ['radio', 'checkbox'].includes(control.type)) {
              control.checked = false;
            } else {
              control.value = '';
            }
          });
        });

        if (restricted) {
          cakePicker.fileList.replaceChildren();
          cakePicker.sync();
          return;
        }

        if (!checked('cakeFlavor')) form.querySelector('[name="cakeFlavor"]').checked = true;
        if (!checked('frostingFlavor')) form.querySelector('[name="frostingFlavor"]').checked = true;
        setCustomizationDetails();
        cakePicker.sync();
      }

      function createInspirationPicker(group) {
        const noun = group.dataset.inspirationNoun;
        const selectionName = group.dataset.selectionName;
        const carousel = group.querySelector('[data-inspiration-carousel]');
        const track = group.querySelector('[data-inspiration-track]');
        const items = Array.from(group.querySelectorAll('[data-inspiration-item]'));
        const inputs = Array.from(group.querySelectorAll(`[name="${selectionName}"]`));
        const filters = Array.from(group.querySelectorAll('[data-inspiration-filter]'));
        const browseButton = group.querySelector('[data-inspiration-browse]');
        const previewLimit = Number(group.dataset.inspirationPreviewLimit) || 0;
        let browsingAll = false;
        let selectedTag = '';
        const status = group.querySelector('[data-inspiration-status]');
        const tray = group.querySelector('[data-inspiration-selected-tray]');
        const count = group.querySelector('[data-inspiration-count]');
        const fileInput = group.querySelector('[data-reference-images]');
        const fileList = group.querySelector('[data-reference-file-list]');
        const selectedInputs = () => inputs.filter((input) => input.checked);
        const inputFor = (id) => inputs.find((input) => input.value === id);

        function updateVisibleItems() {
          items.forEach((item, index) => {
            let tags = [];
            try { tags = JSON.parse(item.dataset.inspirationTags || '[]'); } catch { tags = []; }
            item.hidden = Boolean(previewLimit && !browsingAll && index >= previewLimit)
              || Boolean(selectedTag && !tags.includes(selectedTag));
          });
          carousel?.scrollTo({ left: 0, behavior: 'auto' });
        }

        function resetView() {
          browsingAll = false;
          selectedTag = '';
          group.classList.toggle('is-previewing', Boolean(previewLimit));
          if (browseButton) {
            browseButton.setAttribute('aria-expanded', 'false');
            browseButton.textContent = `Browse all ${items.length} styles`;
          }
          filters.forEach((button) => {
            const active = !button.dataset.inspirationFilter;
            button.classList.toggle('is-active', active);
            button.setAttribute('aria-pressed', String(active));
          });
          updateVisibleItems();
        }

        function sync(statusMessage = '') {
          const selected = selectedInputs();
          const selectedIds = new Set(selected.map((input) => input.value));

          items.forEach((item) => {
            const isSelected = selectedIds.has(item.dataset.inspirationId);
            item.classList.toggle('is-selected', isSelected);
            const badge = item.querySelector('[data-inspiration-selected-badge]');
            const trigger = item.querySelector('[data-inspiration-open]');
            const input = inputFor(item.dataset.inspirationId);
            if (badge) badge.hidden = !isSelected;
            if (trigger && input) {
              trigger.setAttribute('aria-label',
                `View details for ${input.dataset.label}${isSelected ? ', selected as inspiration' : ''}`);
            }
          });

          group.querySelectorAll('[data-inspiration-selected-entry]').forEach((entry) => {
            entry.hidden = !selectedIds.has(entry.dataset.inspirationSelectedEntry);
          });

          group.querySelectorAll('[data-use-inspiration]').forEach((button) => {
            const isSelected = selectedIds.has(button.dataset.useInspiration);
            const limitReached = selected.length >= maxInspirationSelections && !isSelected;
            const limitMessage = button.closest('dialog')?.querySelector('[data-inspiration-dialog-limit]');
            button.textContent = isSelected
              ? 'Remove from inspiration'
              : limitReached ? `3 ${noun} selected` : 'Use as inspiration';
            button.classList.toggle('is-selected', isSelected);
            button.disabled = limitReached;
            if (limitMessage) limitMessage.hidden = !limitReached;
          });

          if (tray) tray.hidden = selected.length === 0;
          if (count) count.textContent = String(selected.length);
          if (status) {
            status.textContent = statusMessage
              || (selected.length
                ? `${selected.length} of ${maxInspirationSelections} ${noun} selected`
                : `Pick up to ${maxInspirationSelections} ${noun}`);
            status.classList.toggle('is-limit', Boolean(statusMessage));
          }
        }

        function toggle(id, dialog) {
          const input = inputFor(id);
          if (!(input instanceof HTMLInputElement) || input.disabled) return;
          if (!input.checked && selectedInputs().length >= maxInspirationSelections) {
            sync(`You can choose up to ${maxInspirationSelections} inspiration ${noun}`);
            return;
          }
          input.checked = !input.checked;
          sync();
          updateEstimate();
          if (dialog instanceof HTMLDialogElement) dialog.close();
        }

        function scroll(direction) {
          if (!(carousel instanceof HTMLElement)) return;
          const firstVisibleItem = items.find((item) => !item.hidden);
          if (!(firstVisibleItem instanceof HTMLElement)) return;
          const gap = track instanceof HTMLElement
            ? Number.parseFloat(window.getComputedStyle(track).columnGap) || 0 : 0;
          carousel.scrollBy({
            left: direction * (firstVisibleItem.getBoundingClientRect().width + gap),
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        }

        function validateFiles() {
          const files = Array.from(fileInput.files || []);
          fileList.replaceChildren();
          if (files.length > maxFiles) return `Please attach no more than ${maxFiles} images`;
          for (const file of files) {
            if (!allowedTypes.includes(file.type)) return `${file.name} is not a PNG, JPG, or WebP image`;
            if (file.size > maxFileSize) return `${file.name} is larger than 2 MB`;
          }
          if (files.reduce((total, file) => total + file.size, 0) > maxTotalFileSize) {
            return 'Reference images must be 4 MB or smaller in total';
          }
          files.forEach((file) => {
            const item = document.createElement('li');
            item.textContent = `${file.name} (${Math.ceil(file.size / 1024)} KB)`;
            fileList.append(item);
          });
          return '';
        }

        filters.forEach((button) => {
          button.addEventListener('click', () => {
            selectedTag = button.dataset.inspirationFilter || '';
            filters.forEach((filterButton) => {
              const isActive = filterButton === button;
              filterButton.classList.toggle('is-active', isActive);
              filterButton.setAttribute('aria-pressed', String(isActive));
            });
            updateVisibleItems();
          });
        });

        browseButton?.addEventListener('click', () => {
          browsingAll = !browsingAll;
          if (!browsingAll) {
            selectedTag = '';
            filters.forEach((button) => {
              const active = !button.dataset.inspirationFilter;
              button.classList.toggle('is-active', active);
              button.setAttribute('aria-pressed', String(active));
            });
          }
          group.classList.toggle('is-previewing', !browsingAll);
          browseButton.setAttribute('aria-expanded', String(browsingAll));
          browseButton.textContent = browsingAll ? 'Show fewer styles' : `Browse all ${items.length} styles`;
          updateVisibleItems();
        });

        group.querySelector('[data-inspiration-previous]')?.addEventListener('click', () => scroll(-1));
        group.querySelector('[data-inspiration-next]')?.addEventListener('click', () => scroll(1));

        group.querySelectorAll('[data-inspiration-open]').forEach((trigger) => {
          const dialog = document.getElementById(trigger.getAttribute('aria-controls'));
          if (!(dialog instanceof HTMLDialogElement)) return;
          trigger.addEventListener('click', () => {
            dialog.showModal();
            document.body.classList.add('inspiration-dialog-open');
          });
          dialog.querySelector('[data-inspiration-dialog-close]')?.addEventListener('click', () => dialog.close());
          dialog.addEventListener('click', (event) => {
            if (event.target === dialog) dialog.close();
          });
          dialog.addEventListener('close', () => {
            document.body.classList.remove('inspiration-dialog-open');
            trigger.focus();
          });
        });

        group.querySelectorAll('[data-use-inspiration]').forEach((button) => {
          button.addEventListener('click', () => toggle(button.dataset.useInspiration, button.closest('dialog')));
        });
        group.querySelectorAll('[data-inspiration-remove]').forEach((button) => {
          button.addEventListener('click', () => {
            const input = inputFor(button.dataset.inspirationRemove);
            if (!(input instanceof HTMLInputElement)) return;
            input.checked = false;
            sync();
            updateEstimate();
          });
        });
        fileInput.addEventListener('change', () => {
          const error = validateFiles();
          message.textContent = error;
          message.classList.toggle('error', Boolean(error));
          updateEstimate();
        });

        return { group, fileInput, fileList, selectedInputs, sync, validateFiles, resetView };
      }

      function addSummaryLine(label, value, amount, amountLabel = '') {
        const dt = document.createElement('dt');
        const dd = document.createElement('dd');
        dt.textContent = label;
        const description = document.createElement('span');
        const price = document.createElement('strong');
        description.textContent = value || 'Not selected';
        price.textContent = amountLabel || (amount ? formatter.format(amount) : 'Included');
        dd.append(description, price);
        summaryLines.append(dt, dd);
      }

      const bakeryQuantities = Array.from(form.querySelectorAll('[data-bakery-quantity]'));

      function syncOrderSections() {
        const includeCake = Boolean(checked('includeCake'));
        const includeCupcakes = Boolean(checked('includeCupcakes'));
        const includeBakery = Boolean(checked('includeBakery'));
        const hasSelection = includeCake || includeCupcakes || includeBakery;
        form.classList.toggle('is-starting', !hasSelection);
        form.classList.toggle('has-mobile-estimate', hasSelection);
        mobileEstimate.classList.toggle('hidden', !hasSelection);
        form.querySelector('.order-summary').classList.toggle('hidden', !hasSelection);
        choiceStep.querySelector('[data-step-continue]').disabled = !hasSelection;
        const contact = form.querySelector('[data-contact-section]');
        contact.classList.toggle('hidden', !hasSelection);
        contact.querySelectorAll('input').forEach((input) => { input.disabled = !hasSelection; });
        form.querySelectorAll('[data-order-panel]').forEach((panel) => {
          const enabled = panel.dataset.orderPanel === 'cupcakes' ? includeCupcakes : includeBakery;
          panel.classList.toggle('hidden', !enabled);
          panel.querySelectorAll('[data-bakery-quantity]').forEach((input) => {
            input.disabled = !enabled;
            if (!enabled) input.value = '0';
          });
        });
        setCustomizationAvailability();
        syncCupcakeOptions();
        let step = 2;
        form.querySelectorAll('.order-section:not(.hidden):not(.order-start) > summary .step-label').forEach((label) => {
          label.textContent = String(step++);
        });
        if (formSteps.some((panel) => panel.open && panel.closest('.hidden'))) {
          openStep(choiceStep);
        }
        updateEstimate();
      }

      function selectedBakeryItems() {
        return bakeryQuantities.filter((input) => !input.disabled && Number(input.value) > 0);
      }

      function syncCupcakeOptions() {
        const selected = Boolean(checked('includeCupcakes'));
        const panel = form.querySelector('[data-cupcake-options]');
        panel.classList.toggle('hidden', !selected);
        panel.querySelectorAll('input, textarea').forEach((input) => {
          input.disabled = !selected;
          if (!selected) {
            if (input.type === 'radio') input.checked = false;
            else input.value = '';
          }
        });
        if (selected && !checked('cupcakeFlavor')) panel.querySelector('input').checked = true;
        cupcakePicker.group.querySelectorAll('input, textarea').forEach((input) => {
          input.disabled = !selected;
          if (!selected) {
            if (input.type === 'checkbox') input.checked = false;
            else input.value = '';
          }
        });
        if (!selected) cupcakePicker.fileList.replaceChildren();
        cupcakePicker.sync();
      }

      function updateEstimate() {
        const includeCake = Boolean(checked('includeCake'));
        const size = includeCake ? checked('cakeSize') : null;
        const flavor = checked('cakeFlavor');
        const restricted = customizationsAreRestricted();
        const paidCustomizations = restricted ? [] : paidCustomizationNames.map(checked).filter(Boolean);
        const bakeryItems = selectedBakeryItems();
        const pricingPending = bakeryItems.some((input) => input.dataset.pricingPending === 'true');
        const total = priceOf(size) + (restricted ? 0 : priceOf(flavor))
          + paidCustomizations.reduce((sum, input) => sum + priceOf(input), 0)
          + bakeryItems.reduce((sum, input) => sum + priceOf(input) * Number(input.value), 0);

        totalOutput.value = pricingPending && total === 0 ? 'Price TBD' : formatter.format(total);
        const estimateLabel = pricingPending ? 'Priced subtotal' : 'Estimate';
        document.getElementById('summary-heading').textContent = estimateLabel;
        mobileEstimateLabel.textContent = estimateLabel;
        mobileEstimateTotal.value = totalOutput.value;
        const inspirationParts = [];
        const selectedStyles = cakePicker.selectedInputs().length;
        const referencePhotos = cakePicker.fileInput.files.length;
        if (selectedStyles) inspirationParts.push(`${selectedStyles} style${selectedStyles === 1 ? '' : 's'} selected`);
        if (referencePhotos) inspirationParts.push(`${referencePhotos} photo${referencePhotos === 1 ? '' : 's'} added`);
        if (form.elements.cakeInspirationComments.value.trim()) inspirationParts.push('Notes added');
        inspirationSection.querySelector('[data-inspiration-section-note]').textContent = inspirationParts.length
          ? inspirationParts.join(' · ') : 'Optional · Photos and notes';
        form.querySelector('[data-pending-price-note]').hidden = !pricingPending;
        summaryLines.replaceChildren();
        bakeryItems.forEach((input) => {
          const cupcake = input.dataset.productId === 'cupcakes-dozen';
          const flavorLabel = cupcake ? ` · ${checked('cupcakeFlavor')?.value || 'choose a flavor'}` : '';
          addSummaryLine(`× ${input.value}`, labelOf(input) + flavorLabel,
            priceOf(input) * Number(input.value), input.dataset.pricingPending === 'true' ? 'Price TBD' : '');
        });
        if (checked('includeCupcakes')) {
          const cupcakeGallery = cupcakePicker.selectedInputs();
          const cupcakeFiles = Array.from(cupcakePicker.fileInput.files || []);
          addSummaryLine('Cupcake inspiration', cupcakeGallery.length ? cupcakeGallery.map(labelOf).join(', ') : 'None selected', 0);
          if (form.elements.cupcakeInspirationComments.value.trim()) addSummaryLine('Cupcake inspiration comments', form.elements.cupcakeInspirationComments.value.trim(), 0);
          addSummaryLine('Cupcake reference photos', cupcakeFiles.length ? `${cupcakeFiles.length} selected` : 'None selected', 0);
        }
        if (!includeCake) return;
        addSummaryLine('Cake size', labelOf(size), priceOf(size));
        if (restricted) {
          addSummaryLine('Cake customizations', 'Not available for this size', 0, 'As-is');
          return;
        }
        addSummaryLine('Cake flavor', labelOf(flavor), priceOf(flavor));
        addSummaryLine('Frosting flavor', labelOf(checked('frostingFlavor')), 0);
        paidCustomizations.forEach((input) => {
          addSummaryLine(labelOf(input), 'Selected', priceOf(input));
        });
        const gallery = cakePicker.selectedInputs();
        const files = Array.from(cakePicker.fileInput.files || []);
        addSummaryLine('Cake inspiration', gallery.length ? gallery.map(labelOf).join(', ') : 'None selected', 0);
        if (form.elements.cakeInspirationComments.value.trim()) addSummaryLine('Cake inspiration comments', form.elements.cakeInspirationComments.value.trim(), 0);
        addSummaryLine('Cake reference photos', files.length ? `${files.length} selected` : 'None selected', 0);
      }

      function validateForm() {
        const errors = [];
        const name = form.elements.customerName.value.trim();
        const eventDate = form.elements.eventDate.value;
        const email = form.elements.email.value.trim();
        const phone = form.elements.phone.value.trim();
        const cakeFlavor = checked('cakeFlavor')?.value;
        const pickupLocation = checked('pickupLocation')?.value;

        if (!checked('includeCake') && !selectedBakeryItems().length) errors.push('Choose at least one item to order');
        if (checked('includeCake') && !checked('cakeSize')) errors.push('Choose a cake size');
        bakeryQuantities.forEach((input) => {
          if (!input.disabled && (!input.value || !input.checkValidity())) errors.push(`Enter a whole-number quantity from 0 to 99 for ${labelOf(input)}`);
        });
        if (checked('includeCupcakes') && Number(form.elements['quantity-cupcakes-dozen'].value) < 1) {
          errors.push('Choose at least one dozen cupcakes, or deselect Cupcakes');
        }
        if (checked('includeCupcakes') && !checked('cupcakeFlavor')) {
          errors.push('Choose vanilla or chocolate for your cupcakes');
        }
        if (checked('includeCupcakes')) {
          const fileError = cupcakePicker.validateFiles();
          if (fileError) errors.push(fileError);
          if (cupcakePicker.selectedInputs().length > maxInspirationSelections) {
            errors.push(`Choose no more than ${maxInspirationSelections} inspiration cupcakes`);
          }
        }
        const allReferenceFiles = [
          ...Array.from(cakePicker.fileInput.files || []),
          ...Array.from(cupcakePicker.fileInput.files || []),
        ];
        if (allReferenceFiles.reduce((total, file) => total + file.size, 0) > maxTotalFileSize) {
          errors.push('Reference images must be 4 MB or smaller in total for your order');
        }
        if (email && !form.elements.email.checkValidity()) errors.push('Please enter a valid email address');
        if (!name) errors.push('Name is required');
        if (!eventDate) errors.push('Event date is required');
        if (eventDate) {
          const parsedEventDate = dateValueToLocalDate(eventDate);
          const minDate = minimumEventDate();
          if (!parsedEventDate) {
            errors.push('Choose a valid event date');
          } else if (parsedEventDate < minDate) {
            errors.push(`Choose an event date at least one week away (${formatDisplayDate(minDate)} or later)`);
          }
        }
        if (phone.replace(/\D/g, '').length < 10 || phone.replace(/\D/g, '').length > 15) {
          errors.push('Enter a mobile number with 10 to 15 digits so I can text you');
        }
        if (!pickupLocation) errors.push('Choose Quincy Center or Fenway for pickup');
        if (!checked('bostonMetroConfirmed')) errors.push('Confirm you can pick up in the location selected');
        if (!customizationsAreRestricted()) {
          if (!cakeFlavor) errors.push('Choose a cake flavor');
          if (!checked('frostingFlavor')) errors.push('Choose a frosting flavor');
          if (cakeFlavor === 'custom' && !form.elements.customFlavorRequest.value.trim()) {
            errors.push('Describe your custom cake flavor');
          }
          paidCustomizationNames.forEach((name) => {
            if (checked(name) && !form.elements[`${name}Request`].value.trim()) {
              errors.push(`Add details for ${labelOf(checked(name)).toLowerCase()}`);
            }
          });

          const fileError = cakePicker.validateFiles();
          if (fileError) errors.push(fileError);
          if (cakePicker.selectedInputs().length > maxInspirationSelections) {
            errors.push(`Choose no more than ${maxInspirationSelections} inspiration cakes`);
          }
        }
        return errors;
      }

      form.addEventListener('change', (event) => {
        if (['cakeSize', 'includeCake', 'includeCupcakes', 'includeBakery'].includes(event.target.name)) {
          if (event.target.name === 'includeCupcakes' && event.target.checked) {
            form.elements['quantity-cupcakes-dozen'].value = '1';
          }
          syncOrderSections();
        }
        if (event.target.name === 'cakeFlavor' || paidCustomizationNames.includes(event.target.name)) {
          setCustomizationDetails();
        }
        updateEstimate();
        if (event.target.name === 'cakeSize' && event.target.checked) {
          const cakeStep = form.querySelector('[data-cake-section]');
          if (cakeStep.open) {
            const steps = visibleSteps();
            openStep(steps[steps.indexOf(cakeStep) + 1], true);
          }
        }
      });

      form.addEventListener('input', () => {
        syncCupcakeOptions();
        updateEstimate();
        if (message.classList.contains('error')) return;
        message.textContent = '';
      });

      confirmation.querySelectorAll('[data-confirmation-close]').forEach((button) => {
        button.addEventListener('click', () => confirmation.close());
      });

      confirmation.addEventListener('click', (event) => {
        if (event.target === confirmation) confirmation.close();
      });

      confirmation.addEventListener('close', () => {
        confetti.replaceChildren();
        choiceStep.querySelector(':scope > summary')?.focus();
      });

      function showOrderConfirmation() {
        const pieces = document.createDocumentFragment();
        const shades = ['#f5a9c2', '#e8749e', '#f7c4d4', '#dc5f8c'];

        for (let index = 0; index < 36; index += 1) {
          const piece = document.createElement('span');
          piece.style.setProperty('--confetti-left', `${3 + ((index * 37) % 94)}%`);
          piece.style.setProperty('--confetti-delay', `${(index % 9) * 80}ms`);
          piece.style.setProperty('--confetti-duration', `${2.8 + (index % 5) * 0.25}s`);
          piece.style.setProperty('--confetti-drift', `${((index * 23) % 50) - 25}px`);
          piece.style.setProperty('--confetti-color', shades[index % shades.length]);
          pieces.appendChild(piece);
        }

        confetti.replaceChildren(pieces);
        confirmation.showModal();
      }

      let pendingRequestId = null;
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (form.elements.website.value) return;
        syncMinimumEventDate();
        const errors = validateForm();
        message.classList.toggle('error', errors.length > 0);
        if (errors.length) {
          message.textContent = errors.join(' · ');
          return;
        }

        const submitButton = form.querySelector('[data-submit-button]');
        const originalLabel = submitButton.textContent;
        submitButton.disabled = true;
        submitButton.textContent = 'Sending request';
        message.classList.remove('error');
        message.textContent = 'Saving your order request';
        pendingRequestId ||= crypto.randomUUID();

        try {
          const response = await fetch('/api/orders', {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json', 'Idempotency-Key': pendingRequestId },
          });
          const result = await response.json().catch(() => ({}));

          if (!response.ok) {
            throw new Error((result.error || 'Unable to send your request. Please try again').replace(/\.+$/, ''));
          }

          message.textContent = '';
          pendingRequestId = null;
          form.reset();
          cakePicker.fileList.replaceChildren();
          cupcakePicker.fileList.replaceChildren();
          cakePicker.resetView();
          cupcakePicker.resetView();
          formSteps.forEach((panel) => { panel.open = false; });
          syncOrderSections();
          showOrderConfirmation();
        } catch (error) {
          message.classList.add('error');
          message.textContent = error instanceof Error
            ? error.message.replace(/\.+$/, '')
            : 'Unable to send your request. Please try again';
        } finally {
          submitButton.disabled = false;
          submitButton.textContent = originalLabel;
        }
      });

      syncMinimumEventDate();
      syncOrderSections();
    </script>
  </main>

  <SiteFooter />
</Layout>
