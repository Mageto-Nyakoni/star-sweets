---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { cakeOrderOptions as fallbackOrderOptions } from '../data/orderFallback.js';

let orderOptions = fallbackOrderOptions;
let orderSource = 'sample';

const { isSanityConfigured, fetchCakeOrderOptions } = await import('../lib/sanity.js');

if (isSanityConfigured()) {
  try {
    orderOptions = await fetchCakeOrderOptions();
    orderSource = 'sanity';
  } catch {
    orderOptions = fallbackOrderOptions;
  }
}

const money = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
  maximumFractionDigits: 0,
});

const priceLabel = (amount = 0, base = false) => {
  const value = Number(amount) || 0;
  return base ? money.format(value) : value === 0 ? 'Included' : `+${money.format(value)}`;
};

const firstSizeId = orderOptions.sizes?.[0]?._id;
const firstFillingId = orderOptions.fillings?.[0]?._id;
const firstFrostingId = orderOptions.frostings?.[0]?._id;
const firstTierId = orderOptions.tiers?.[0]?._id;
---

<Layout
  title="Custom Cake Orders - Star Sweets"
  description="Build a custom Star Sweets cake request with live pricing and inspiration options."
>
  <Navbar />

  <main class="order-page">
    <section class="order-intro" aria-labelledby="order-title">
      <div>
        <p class="order-kicker">Custom cake request</p>
        <h1 id="order-title">Build your celebration cake</h1>
        <p>
          Choose a size, flavor direction, filling, frosting, tiers, and finishing touches.
          Your running estimate updates as you build.
        </p>
      </div>
      <a class="order-intro-link" href="#cake-builder">Start order</a>
    </section>

    <form id="cake-builder" class="order-builder" novalidate>
      <input
        class="order-honeypot"
        type="text"
        name="website"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />

      <div class="order-form">
        <section class="order-section" aria-labelledby="contact-heading">
          <div class="section-copy">
            <p class="step-label">1</p>
            <div>
              <h2 id="contact-heading">Contact and date</h2>
              <p>Name, event date, and one way to reach you are required.</p>
            </div>
          </div>

          <div class="field-grid">
            <label>
              <span>Name</span>
              <input type="text" name="customerName" autocomplete="name" required />
            </label>
            <label>
              <span>Event date</span>
              <input type="date" name="eventDate" required />
            </label>
            <label>
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" />
            </label>
            <label>
              <span>Phone</span>
              <input type="tel" name="phone" autocomplete="tel" />
            </label>
          </div>
        </section>

        <section class="order-section" aria-labelledby="size-heading">
          <div class="section-copy">
            <p class="step-label">2</p>
            <div>
              <h2 id="size-heading">Cake foundation</h2>
              <p>Base prices come from Sanity and stay editable in Studio.</p>
            </div>
          </div>

          <fieldset>
            <legend>Size</legend>
            <div class="option-grid">
              {orderOptions.sizes.map((size) => (
                <label class="choice-card">
                  <input
                    type="radio"
                    name="cakeSize"
                    value={size._id}
                    data-label={size.name}
                    data-price={size.basePrice}
                    checked={size._id === firstSizeId}
                    required
                  />
                  <span>
                    <strong>{size.name}</strong>
                    {size.servings && <small>{size.servings}</small>}
                  </span>
                  <em>{priceLabel(size.basePrice, true)}</em>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset>
            <legend>Tiers</legend>
            <div class="option-grid compact">
              {orderOptions.tiers.map((tier) => (
                <label class="choice-card">
                  <input
                    type="radio"
                    name="tierOption"
                    value={tier._id}
                    data-label={tier.label}
                    data-price={tier.priceModifier}
                    checked={tier._id === firstTierId}
                  />
                  <span>
                    <strong>{tier.label}</strong>
                    <small>{tier.tiers} tier{tier.tiers === 1 ? '' : 's'}</small>
                  </span>
                  <em>{priceLabel(tier.priceModifier)}</em>
                </label>
              ))}
            </div>
          </fieldset>
        </section>

        <section class="order-section" aria-labelledby="flavor-heading">
          <div class="section-copy">
            <p class="step-label">3</p>
            <div>
              <h2 id="flavor-heading">Flavor direction</h2>
              <p>Describe what you have in mind or let the baker choose for you.</p>
            </div>
          </div>

          <fieldset class="flavor-tabs">
            <legend>Choose one flavor path</legend>
            <label>
              <input type="radio" name="flavorPath" value="custom" checked />
              <span>Custom request</span>
            </label>
            <label>
              <input type="radio" name="flavorPath" value="surprise" />
              <span>Surprise me</span>
            </label>
          </fieldset>

          <div class="flavor-panel" data-flavor-panel="custom">
            <label>
              <span>Custom flavor request</span>
              <textarea
                name="customFlavorRequest"
                rows="4"
                placeholder="Tell me the flavor, filling, inspiration, or dietary detail you have in mind."
              ></textarea>
            </label>
            <p class="field-note">Custom flavors are subject to baker approval and may affect the final price.</p>
          </div>

          <div class="flavor-panel hidden" data-flavor-panel="surprise">
            <div class="notice-box">
              <strong>Baker's choice selected.</strong>
              <p>I will choose a flavor direction that fits your event notes and may email you before confirming.</p>
            </div>
          </div>
        </section>

        <section class="order-section" aria-labelledby="finish-heading">
          <div class="section-copy">
            <p class="step-label">4</p>
            <div>
              <h2 id="finish-heading">Fillings, frosting, and add-ons</h2>
              <p>Select one filling, one frosting, and any extras you want.</p>
            </div>
          </div>

          <fieldset>
            <legend>Filling</legend>
            <div class="option-grid compact">
              {orderOptions.fillings.map((filling) => (
                <label class="choice-card">
                  <input
                    type="radio"
                    name="cakeFilling"
                    value={filling._id}
                    data-label={filling.name}
                    data-price={filling.priceModifier}
                    checked={filling._id === firstFillingId}
                  />
                  <span>
                    <strong>{filling.name}</strong>
                    {filling.description && <small>{filling.description}</small>}
                  </span>
                  <em>{priceLabel(filling.priceModifier)}</em>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset>
            <legend>Frosting</legend>
            <div class="option-grid compact">
              {orderOptions.frostings.map((frosting) => (
                <label class="choice-card">
                  <input
                    type="radio"
                    name="cakeFrosting"
                    value={frosting._id}
                    data-label={frosting.name}
                    data-price={frosting.priceModifier}
                    checked={frosting._id === firstFrostingId}
                  />
                  <span>
                    <strong>{frosting.name}</strong>
                    {frosting.description && <small>{frosting.description}</small>}
                  </span>
                  <em>{priceLabel(frosting.priceModifier)}</em>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset>
            <legend>Add-ons</legend>
            <div class="option-grid compact">
              {orderOptions.addOns.map((addOn) => (
                <label class="choice-card">
                  <input
                    type="checkbox"
                    name="addOns"
                    value={addOn._id}
                    data-label={addOn.name}
                    data-price={addOn.priceModifier}
                  />
                  <span>
                    <strong>{addOn.name}</strong>
                    {addOn.description && <small>{addOn.description}</small>}
                  </span>
                  <em>{priceLabel(addOn.priceModifier)}</em>
                </label>
              ))}
            </div>
          </fieldset>
        </section>

        <section class="order-section" aria-labelledby="inspo-heading">
          <div class="section-copy">
            <p class="step-label">5</p>
            <div>
              <h2 id="inspo-heading">Inspiration</h2>
              <p>Mark past styles you like or attach your own reference photos.</p>
            </div>
          </div>

          <fieldset>
            <legend>Past cake gallery</legend>
            <div class="gallery-grid">
              {orderOptions.gallery.map((item, index) => (
                <label class="gallery-choice">
                  <input
                    type="checkbox"
                    name="inspirationSelections"
                    value={item._id}
                    data-label={item.caption}
                  />
                  {item.imageUrl ? (
                    <img src={item.imageUrl} alt={item.caption} loading="lazy" />
                  ) : (
                    <span class={`gallery-placeholder style-${(index % 3) + 1}`} aria-hidden="true"></span>
                  )}
                  <span>
                    <strong>{item.caption}</strong>
                    {Array.isArray(item.tags) && item.tags.length > 0 && <small>{item.tags.join(', ')}</small>}
                  </span>
                </label>
              ))}
            </div>
          </fieldset>

          <label class="upload-drop">
            <span>Reference photos</span>
            <input
              id="reference-images"
              type="file"
              name="referenceImages"
              accept="image/png,image/jpeg,image/webp"
              multiple
            />
            <small>PNG, JPG, or WebP. Up to 5 images, 5 MB each.</small>
          </label>
          <ul id="file-list" class="file-list" aria-live="polite"></ul>

          <label>
            <span>Notes</span>
            <textarea
              name="notes"
              rows="4"
              placeholder="Colors, theme, allergies, pickup timing, or anything I should know."
            ></textarea>
          </label>
        </section>
      </div>

      <aside class="order-summary" aria-labelledby="summary-heading">
        <div class="summary-inner">
          <p class="summary-source">
            {orderSource === 'sanity' ? 'Live menu pricing' : 'Sample pricing until Sanity is connected'}
          </p>
          <h2 id="summary-heading">Estimate</h2>
          <output id="order-total" for="cake-builder">$0</output>
          <p class="summary-note">
            Custom flavors, special sourcing, and complex design details may need a follow-up quote.
          </p>

          <dl id="summary-lines" class="summary-lines"></dl>

          <div id="form-message" class="form-message" role="status" aria-live="polite"></div>

          <button class="submit-button" type="submit">
            Review cake request
          </button>
        </div>
      </aside>
    </form>

    <script type="application/json" id="cake-order-data" set:html={JSON.stringify(orderOptions)} />
    <script is:inline>
      const form = document.getElementById('cake-builder');
      const totalOutput = document.getElementById('order-total');
      const summaryLines = document.getElementById('summary-lines');
      const message = document.getElementById('form-message');
      const fileInput = document.getElementById('reference-images');
      const fileList = document.getElementById('file-list');
      const dataElement = document.getElementById('cake-order-data');
      const orderData = JSON.parse(dataElement.textContent || '{}');
      const formatter = new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        maximumFractionDigits: 0,
      });
      const maxFiles = 5;
      const maxFileSize = 5 * 1024 * 1024;
      const allowedTypes = ['image/png', 'image/jpeg', 'image/webp'];

      function checked(name) {
        return form.querySelector(`[name="${name}"]:checked`);
      }

      function checkedAll(name) {
        return Array.from(form.querySelectorAll(`[name="${name}"]:checked`));
      }

      function priceOf(input) {
        return Number(input?.dataset.price || 0);
      }

      function labelOf(input) {
        return input?.dataset.label || '';
      }

      function setFlavorPath() {
        const path = checked('flavorPath')?.value || 'custom';
        form.querySelectorAll('[data-flavor-panel]').forEach((panel) => {
          panel.classList.toggle('hidden', panel.dataset.flavorPanel !== path);
        });

        const customInput = form.elements.customFlavorRequest;
        customInput.disabled = path !== 'custom';
        if (path !== 'custom') {
          customInput.value = '';
        }
      }

      function addSummaryLine(label, value, amount) {
        const dt = document.createElement('dt');
        const dd = document.createElement('dd');
        dt.textContent = label;
        dd.innerHTML = `<span>${value || 'Not selected'}</span><strong>${amount ? formatter.format(amount) : 'Included'}</strong>`;
        summaryLines.append(dt, dd);
      }

      function updateEstimate() {
        const size = checked('cakeSize');
        const tier = checked('tierOption');
        const filling = checked('cakeFilling');
        const frosting = checked('cakeFrosting');
        const flavorPath = checked('flavorPath')?.value || 'custom';
        const addOns = checkedAll('addOns');
        const gallery = checkedAll('inspirationSelections');

        const total = [
          priceOf(size),
          priceOf(tier),
          priceOf(filling),
          priceOf(frosting),
          ...addOns.map(priceOf),
        ].reduce((sum, value) => sum + value, 0);

        totalOutput.value = formatter.format(total);
        summaryLines.replaceChildren();
        addSummaryLine('Size', labelOf(size), priceOf(size));
        addSummaryLine('Tiers', labelOf(tier), priceOf(tier));
        addSummaryLine(
          'Flavor',
          flavorPath === 'surprise' ? "Baker's choice" : 'Custom request',
          0
        );
        addSummaryLine('Filling', labelOf(filling), priceOf(filling));
        addSummaryLine('Frosting', labelOf(frosting), priceOf(frosting));
        addSummaryLine(
          'Add-ons',
          addOns.length ? addOns.map(labelOf).join(', ') : 'None selected',
          addOns.reduce((sum, input) => sum + priceOf(input), 0)
        );
        addSummaryLine(
          'Inspiration',
          gallery.length ? gallery.map(labelOf).join(', ') : 'None selected',
          0
        );
      }

      function validateFiles() {
        const files = Array.from(fileInput.files || []);
        fileList.replaceChildren();
        if (files.length > maxFiles) {
          return `Please attach no more than ${maxFiles} images.`;
        }

        for (const file of files) {
          if (!allowedTypes.includes(file.type)) {
            return `${file.name} is not a PNG, JPG, or WebP image.`;
          }
          if (file.size > maxFileSize) {
            return `${file.name} is larger than 5 MB.`;
          }
        }

        files.forEach((file) => {
          const item = document.createElement('li');
          item.textContent = `${file.name} (${Math.ceil(file.size / 1024)} KB)`;
          fileList.append(item);
        });
        return '';
      }

      function validateForm() {
        const errors = [];
        const name = form.elements.customerName.value.trim();
        const eventDate = form.elements.eventDate.value;
        const email = form.elements.email.value.trim();
        const phone = form.elements.phone.value.trim();
        const flavorPath = checked('flavorPath')?.value;

        if (!name) errors.push('Name is required.');
        if (!eventDate) errors.push('Event date is required.');
        if (!email && !phone) errors.push('Please enter an email or phone number.');
        if (!flavorPath) errors.push('Choose a flavor path.');
        if (flavorPath === 'custom' && !form.elements.customFlavorRequest.value.trim()) {
          errors.push('Add a custom flavor request.');
        }

        const fileError = validateFiles();
        if (fileError) errors.push(fileError);
        return errors;
      }

      form.addEventListener('change', (event) => {
        if (event.target.name === 'flavorPath') {
          setFlavorPath();
        }
        if (event.target === fileInput) {
          const fileError = validateFiles();
          message.textContent = fileError;
          message.classList.toggle('error', Boolean(fileError));
        }
        updateEstimate();
      });

      form.addEventListener('input', () => {
        if (message.classList.contains('error')) return;
        message.textContent = '';
      });

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        if (form.elements.website.value) return;
        const errors = validateForm();
        message.classList.toggle('error', errors.length > 0);
        message.textContent = errors.length
          ? errors.join(' ')
          : 'This request is ready for review. After you approve the form, I will connect this button to Sanity and email notifications.';
      });

      setFlavorPath();
      updateEstimate();
    </script>
  </main>

  <SiteFooter />
</Layout>
