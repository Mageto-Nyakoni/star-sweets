---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { aboutPageFallback, withAboutPageFallback } from '../data/aboutFallback.js';

let aboutPage = aboutPageFallback;

const { isSanityConfigured, fetchAboutPage } = await import('../lib/sanity.js');

if (isSanityConfigured()) {
  try {
    aboutPage = withAboutPageFallback(await fetchAboutPage());
  } catch {
    aboutPage = aboutPageFallback;
  }
}
---

<Layout
  title={aboutPage.seoTitle}
  description={aboutPage.seoDescription}
>
  <Navbar />

  <main class="about-page">
    <header class="about-hero">
      <p class="home-eyebrow">{aboutPage.heroEyebrow}</p>
      <h1>{aboutPage.heroTitle}</h1>
      <p class="placement-copy">{aboutPage.heroIntroduction}</p>
    </header>

    <section class="about-story" aria-labelledby="meet-baker">
      <div class="about-brand-mark">
        {aboutPage.portraitUrl ? (
          <img
            class="about-portrait"
            src={aboutPage.portraitUrl}
            alt={aboutPage.portraitAlt || 'Star Sweets baker'}
          />
        ) : (
          <img src="/StarSweets-logo-trimmed.png" alt="Star Sweets" />
        )}
      </div>
      <div>
        <p class="home-eyebrow">{aboutPage.storyEyebrow}</p>
        <h2 id="meet-baker" class="placement-heading">{aboutPage.storyHeading}</h2>
        {aboutPage.biography.map((paragraph) => (
          <p class="placement-copy">{paragraph}</p>
        ))}
      </div>
    </section>

    <section class="about-values" aria-labelledby="values-title">
      <div class="about-values-heading">
        <p class="home-eyebrow">{aboutPage.valuesEyebrow}</p>
        <h2 id="values-title" class="placement-heading">{aboutPage.valuesHeading}</h2>
      </div>
      <div class="about-values-grid">
        {aboutPage.values.map((value, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3 class="placement-heading">{value.title}</h3>
            <p class="placement-copy">{value.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="about-order-band">
      <div>
        <p class="home-eyebrow">{aboutPage.ctaEyebrow}</p>
        <h2>{aboutPage.ctaHeading}</h2>
      </div>
      <a href="/order" class="home-button home-button-primary">{aboutPage.ctaLabel}</a>
    </section>
  </main>

  <SiteFooter />
</Layout>
