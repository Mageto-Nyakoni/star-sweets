---
interface Props {
  title:         string;
  views:         string;
  duration:      string;
  thumbnailUrl?: string;
}

const { title, views, duration, thumbnailUrl } = Astro.props;
---

<article class="mukbang-card">
  <!-- Thumbnail -->
  <div class="mukbang-thumb h-44">
    {thumbnailUrl && (
      <img src={thumbnailUrl} alt={title} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
    )}
    <div class="play-btn" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="#3A1520" viewBox="0 0 24 24">
        <polygon points="5 3 19 12 5 21 5 3"/>
      </svg>
    </div>
  </div>

  <!-- Meta -->
  <div class="bg-ss-cherry text-white p-4">
    <h3 class="font-display font-semibold text-sm leading-snug mb-2">{title}</h3>
    <div class="flex items-center gap-4 text-xs text-ss-pink">
      <!-- Views -->
      <span class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
        {views}
      </span>
      <!-- Duration -->
      <span class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        {duration}
      </span>
    </div>
  </div>
</article>
